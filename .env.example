# Optional: protect MCP, SSE, and OpenAPI endpoints. /health remains public.
API_TOKEN=replace-with-a-long-random-token

# Required by LLM, vision, STT, TTS, image, and diarization upstream calls.
INFOCEPO_API_KEY=replace-with-infocepo-api-key

# Optional service-specific credentials.
INFOCEPO_CHROMA_TOKEN=
INFOCEPO_S3_ACCESS_KEY=
INFOCEPO_S3_SECRET_KEY=
INFOCEPO_REGISTRY_USER=user
INFOCEPO_REGISTRY_PASSWORD=

# Optional listener overrides (run.sh arguments take precedence).
MCP_HOST=0.0.0.0
MCP_PORT=8085

# Optional alternatives:
# VENV_DIR=/absolute/path/to/venv
# INFOCEPO_CREDENTIALS_FILE=/absolute/path/to/credentials.json
